# Actual Syphon transport on macOS; only non-macOS builds use the stub.
# The core API library has no framework or device-discovery dependency.
if(APPLE)
  enable_language(C OBJC OBJCXX)
endif()
function(vj_add_live_source_backend)
  set(vj_native_src "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../native-renderer/src")
  if(APPLE)
    include(FetchContent)
    FetchContent_Declare(vj_syphon
      GIT_REPOSITORY https://github.com/Syphon/Syphon-Framework.git
      GIT_TAG f4761677a45b8034a3c2069ec0f3d2553da81fba)
    FetchContent_MakeAvailable(vj_syphon)
    file(GLOB vj_syphon_files "${vj_syphon_SOURCE_DIR}/*.m" "${vj_syphon_SOURCE_DIR}/*.c")
    # One shared runtime for VJ's OpenGL receivers and Patch's Metal publishers.
    # Loading a second Syphon copy into this process would duplicate ObjC classes.
    list(FILTER vj_syphon_files EXCLUDE REGEX "SyphonServerRendererMetal.m$")
    file(READ "${vj_syphon_SOURCE_DIR}/SyphonServerRendererMetal.m" vj_metal_source)
    string(REPLACE "[device newDefaultLibraryWithBundle:bundle error:&error]" "[device newLibraryWithSource:[NSString stringWithContentsOfURL:[bundle URLForResource:@\"SyphonMetalShaders\" withExtension:@\"metal\"] encoding:NSUTF8StringEncoding error:&error] options:nil error:&error]" vj_metal_source "${vj_metal_source}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/SyphonServerRendererMetal.m" "${vj_metal_source}")
    file(READ "${vj_syphon_SOURCE_DIR}/SyphonMetalShaders.metal" vj_metal_shader)
    file(READ "${vj_syphon_SOURCE_DIR}/SyphonServerMetalTypes.h" vj_metal_types)
    string(REPLACE "#include \"SyphonServerMetalTypes.h\"" "${vj_metal_types}" vj_metal_shader "${vj_metal_shader}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/SyphonMetalShaders.metal" "${vj_metal_shader}")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/syphon-include")
    file(CREATE_LINK "${vj_syphon_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/syphon-include/Syphon" SYMBOLIC)
    add_library(vj_syphon_framework SHARED ${vj_syphon_files} "${CMAKE_CURRENT_BINARY_DIR}/SyphonServerRendererMetal.m" "${CMAKE_CURRENT_BINARY_DIR}/SyphonMetalShaders.metal" "${vj_syphon_SOURCE_DIR}/License.txt")
    set_target_properties(vj_syphon_framework PROPERTIES FRAMEWORK TRUE FRAMEWORK_VERSION A OUTPUT_NAME Syphon MACOSX_FRAMEWORK_IDENTIFIER info.v002.Syphon)
    set_source_files_properties("${CMAKE_CURRENT_BINARY_DIR}/SyphonMetalShaders.metal" "${vj_syphon_SOURCE_DIR}/License.txt" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    target_include_directories(vj_syphon_framework PRIVATE "${vj_syphon_SOURCE_DIR}")
    target_include_directories(vj_syphon_framework PUBLIC "${CMAKE_CURRENT_BINARY_DIR}/syphon-include")
    target_compile_options(vj_syphon_framework PRIVATE "$<$<COMPILE_LANGUAGE:OBJC>:-fobjc-arc>" -fblocks -include "${vj_syphon_SOURCE_DIR}/Syphon_Prefix.pch" -Wno-deprecated-declarations)
    target_compile_definitions(vj_syphon_framework PRIVATE SYPHON_CORE_SHARE)
    target_link_libraries(vj_syphon_framework PUBLIC "-framework Cocoa" "-framework OpenGL" "-framework IOSurface" "-framework Metal" "-framework CoreVideo")
    configure_file("${vj_syphon_SOURCE_DIR}/License.txt" "${CMAKE_CURRENT_BINARY_DIR}/Syphon-LICENSE.txt" COPYONLY)
    add_library(vj_syphon_input STATIC "${vj_native_src}/syphon_input.mm")
    set_target_properties(vj_syphon_input PROPERTIES OBJCXX_STANDARD 20)
    target_compile_options(vj_syphon_input PRIVATE -fobjc-arc -Wno-deprecated-declarations)
    target_link_libraries(vj_syphon_input PUBLIC vj_syphon_framework nlohmann_json::nlohmann_json OpenGL::GL)
  else()
    add_library(vj_syphon_input STATIC "${vj_native_src}/syphon_input_stub.cpp")
    target_link_libraries(vj_syphon_input PUBLIC nlohmann_json::nlohmann_json)
  endif()
  target_link_libraries(vj_preview_engine PUBLIC vj_syphon_input)
  add_executable(vj-source-discovery "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/live_source_discovery.cpp")
  target_link_libraries(vj-source-discovery PRIVATE vj_application vj_preview_engine)
  if(APPLE)
    target_sources(vj-source-discovery PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/live_sources_mac.mm")
    set_target_properties(vj-source-discovery PROPERTIES OBJCXX_STANDARD 20)
    target_compile_options(vj-source-discovery PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc;-Wno-deprecated-declarations>")
    target_link_libraries(vj-source-discovery PRIVATE "-framework AVFoundation")
  endif()
  install(TARGETS vj-source-discovery RUNTIME DESTINATION bin)
endfunction()

# Called at the end of configuration, after the portable service target exists.
function(vj_configure_camera_usage)
  if(APPLE)
    foreach(vj_target vj-render-service vj-source-discovery)
      if(TARGET ${vj_target})
        set(VJ_HELPER_NAME "${vj_target}")
        set(vj_plist "${CMAKE_CURRENT_BINARY_DIR}/${vj_target}-Info.plist")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HelperInfo.plist.in" "${vj_plist}" @ONLY)
        target_link_options(${vj_target} PRIVATE "LINKER:-sectcreate,__TEXT,__info_plist,${vj_plist}")
        set_property(TARGET ${vj_target} APPEND PROPERTY LINK_DEPENDS "${vj_plist}")
        add_custom_command(TARGET ${vj_target} POST_BUILD COMMAND /usr/bin/codesign --force --sign - "$<TARGET_FILE:${vj_target}>" VERBATIM)
      endif()
    endforeach()
  endif()
endfunction()
cmake_language(DEFER CALL vj_configure_camera_usage)
