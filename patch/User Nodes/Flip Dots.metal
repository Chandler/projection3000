float3 flipHue(float hue,float saturation) {
    float3 p=abs(fract(float3(hue)+float3(0,2.0f/3.0f,1.0f/3.0f))*6.0f-3.0f);
    return mix(float3(1),clamp(p-1.0f,0.0f,1.0f),saturation);
}
bool flipText(float2 cell,float2 grid,uint message,constant uint *text) {
    uint length=min(text[1+message],48u);
    int2 size=int2(max(0,int(length)*6-1),7);
    int2 p=int2(cell)-int2(floor((grid-float2(size))*0.5f));
    if (p.x<0 || p.y<0 || p.x>=size.x || p.y>=7 || p.x%6==5) return false;
    uint code=min(text[9+message*48+uint(p.x/6)],127u);
    return (flipGlyphs[code*7+uint(p.y)] & (1u<<uint(4-p.x%6)))!=0;
}
float4 dotPattern(float2 cell,float2 grid,float time,constant float4 *c,constant uint *text) {
    uint messages=clamp(text[0],1u,8u);
    float hold=max(0.1f,c[0].x), duration=max(0.03f,c[0].y), sweep=max(0.0f,c[0].z);
    float period=hold+duration+sweep;
    float cycle=floor(max(0.0f,time)/period);
    uint old=uint(cycle)%messages, next=(old+1)%messages;
    bool before=flipText(cell,grid,old,text), after=flipText(cell,grid,next,text);
    float random=fract(sin(dot(cell,float2(127.1f,311.7f))+cycle*19.17f)*43758.5453f);
    int direction=int(round(c[2].x));
    float scan=direction==2 ? cell.y/max(1.0f,grid.y-1) : cell.x/max(1.0f,grid.x-1);
    if (direction==1) scan=1.0f-scan;
    if (direction==3) scan=random;
    float delay=mix(scan,random,clamp(c[0].w,0.0f,1.0f))*sweep;
    float progress=clamp((fmod(max(0.0f,time),period)-hold-delay)/duration,0.0f,1.0f);
    float width=before==after ? 1.0f : abs(cos(progress*3.14159265359f));
    bool on=progress<0.5f ? before : after;
    float level=on ? 1.0f : c[1].w;
    return float4(flipHue(c[1].x,c[1].y)*level*c[1].z,width);
}
