constant float3 ribbonWhite = float3(1.00000005f,1.00000001f,0.999999937f);

float3 ribbonIntegral(float wavelength) {
    if (wavelength <= 360.0f) return float3(0);
    if (wavelength >= 830.0f) return ribbonIntegralRGB[470];
    float sample = wavelength - 360.0f;
    int i = int(floor(sample));
    float t = sample - float(i);
    return ribbonIntegralRGB[i] + ribbonMatchingRGB[i]*t
        + (ribbonMatchingRGB[i+1]-ribbonMatchingRGB[i])*(t*t*0.5f);
}
float3 ribbonEncode(float3 linear) {
    float3 v = clamp(linear,0.0f,1.0f);
    return select(1.055f*pow(v,float3(1.0f/2.4f))-0.055f,12.92f*v,v<=0.0031308f);
}

float3 blindsHSV(float h, float s) {
    float3 rgb=clamp(abs(fract(h+float3(0,2.0/3.0,1.0/3.0))*6-3)-1,0.0,1.0);
    return mix(float3(1),rgb,s);
}
float3 blindsPalette(float t, int theme) {
    if(theme==0) return blindsHSV(t*0.83,1.0);
    if(theme==1) return blindsHSV(t*0.83,0.38);
    if(theme==7) return float3(1);
    float3 a,b,c,d;
    if(theme==2) { // Sunset
        a=float3(1,.70,.16);b=float3(1,.28,.12);c=float3(.95,.12,.40);d=float3(.38,.12,.70);
    } else if(theme==3) { // Ocean
        a=float3(.10,.95,.80);b=float3(.05,.68,1);c=float3(.08,.28,.90);d=float3(.28,.12,.65);
    } else if(theme==4) { // Forest
        a=float3(.80,.95,.20);b=float3(.18,.70,.25);c=float3(.05,.42,.22);d=float3(.08,.60,.48);
    } else if(theme==5) { // Neon
        a=float3(1,.04,.50);b=float3(.55,.08,1);c=float3(.02,.85,1);d=float3(.55,1,.05);
    } else { // Amber
        a=float3(1,.90,.60);b=float3(1,.64,.20);c=float3(1,.36,.06);d=float3(.75,.12,.03);
    }
    float q=clamp(t,0.0,1.0)*3;
    return q<1?mix(a,b,q):(q<2?mix(b,c,q-1):mix(c,d,q-2));
}
float3 blindsMappingColor(int row, int pattern) {
    if (pattern == 8) {
        // 13 and 36 are coprime: all 36 hues appear once, with large hue jumps.
        int index = (row * 13) % 36;
        return blindsHSV(float(index) / 36.0, 1.0);
    }
    if (pattern == 9) {
        const float3 colors[8] = {float3(1,0,0),float3(0,1,1),float3(1,1,0),float3(0,0,1),float3(0,1,0),float3(1,0,1),float3(1,.4,0),float3(1)};
        return colors[row % 8];
    }
    return row % 2 == 0 ? float3(0,1,1) : float3(1,0,1);
}
float blindsHash(float v) { return fract(sin(v*127.1+31.7)*43758.5453); }
float blindsWrap(float v, float period) { return v-floor(v/period)*period; }
float3 blindsBarColor(float row, float count, int theme, float shift) {
    if (theme >= 8) return blindsMappingColor(int(floor(blindsWrap(row+shift,3600.0))),theme);
    return blindsPalette(blindsWrap(row+shift,count)/max(count-1.0,1.0),theme);
}
// anim = mode, speed variation, flash width, trail length (bars)
// motion = direction, color motion, palette rate, background brightness
// level = brightness, seed
float3 blindsEffect(float2 uv, float time, texture2d<float,access::sample> input,
                    float4 mapping, float4 anim, float4 motion, float4 level,
                    float4 gradientA, float4 gradientB, float4 spectral, float4 spatial) {
    float count=clamp(round(mapping.x*10.0),1.0,100.0);
    int theme=int(clamp(round(mapping.y),0.0,10.0));
    float gap=clamp(mapping.z,0.0,0.95);
    float y=(uv.y-mapping.w)*count;
    float row=floor(y);
    if(row<0.0 || row>=count) return float3(0);
    float coverage=clamp(((1.0-gap)*.5-abs(fract(y)-.5))*float(input.get_height())/count+.5,0.0,1.0);
    int mode=int(clamp(round(anim.x),0.0,5.0));
    float variation=clamp(anim.y,0.0,1.0), width=clamp(anim.z,0.05,1.0);
    float trail=clamp(anim.w,1.0,16.0), seed=round(level.y);
    float intensity=mode==0 ? 1.0 : 0.0, event=0.0, laneColor=0.0;
    int direction=int(round(motion.x));
    if(mode>=1 && mode<=3) {
        int lanes=mode==3 ? 3 : 1;
        for(int lane=0;lane<lanes;++lane) {
            float laneRate=1.0+float(lane)*variation*.73;
            float phase=time*20.0*laneRate+float(lane)*count/3.0+seed;
            float step=floor(phase);
            bool reverse=direction==1 || (direction==2 && int(floor(step/count))%2!=0);
            float position=reverse ? count-1.0-row : row;
            float distance=blindsWrap(step-position,count);
            float span=mode==1 ? 1.0 : trail;
            float lit=distance<span ? pow(max(0.0,1.0-distance/span),1.5) : 0.0;
            lit*=fract(phase)<width ? 1.0 : 0.0;
            if(lit>intensity) { intensity=lit; event=step; laneColor=float(lane)*11.0; }
        }
    } else if(mode==4) {
        float position=direction==1 ? count-1.0-row : row;
        float rate=mix(1.0,0.45+1.8*blindsHash(row+seed),variation);
        float phase=time*3.0*rate-position/count;
        if(direction==2 && int(floor(time*3.0))%2!=0) phase=time*3.0*rate+position/count;
        intensity=fract(phase)<width ? 1.0 : 0.0;
        event=floor(phase); laneColor=floor(blindsHash(row+seed)*36.0);
    } else if(mode==5) {
        float position=(direction==1 ? count-1.0-row : row)/max(count,1.0);
        float phase=time*1.5;
        if(direction==2) phase=1.0-abs(blindsWrap(phase,2.0)-1.0);
        float wave=0.5+0.5*cos((phase-position)*6.2831853);
        intensity=pow(wave,mix(14.0,1.0,width)); event=floor(time*1.5);
    }
    float shift=0.0;
    int colorMotion=int(round(motion.y));
    if(colorMotion==1 && mode!=0) shift=event*7.0+laneColor;
    if(colorMotion==2 && mode!=0) shift=time*max(motion.z,0.0)*36.0;
    float3 color=blindsBarColor(row,count,theme,shift);
    int colorMode=int(round(gradientA.x));
    if(colorMode==1) {
        float fraction=blindsWrap(row+shift,count)/max(count-1.0,1.0);
        color=mix(gradientA.yzw,gradientB.xyz,pow(clamp(fraction,0.0,1.0),clamp(gradientB.w,0.2,5.0)));
    } else if(colorMode==2) {
        float fraction=row/max(count-1.0,1.0);
        float a=max(0.1,spectral.y),b=max(0.1,spectral.z);
        float bandwidth=spectral.w<0.5 ? exp(mix(log(a),log(b),fraction)) : mix(a,b,fraction);
        float position=(uv.x-0.5)*spatial.x+spatial.y;
        float wavelength=595.0-position*470.0;
        float3 transmitted=ribbonIntegral(wavelength+bandwidth*0.5)-ribbonIntegral(wavelength-bandwidth*0.5);
        color=ribbonEncode(spectral.x<0.5 ? ribbonWhite-transmitted : transmitted);
    }
    float floorLight=clamp(motion.w,0.0,1.0);
    return color*mix(floorLight,1.0,intensity)*coverage*max(level.x,0.0);
}
// Compatibility entry point for already-running Patch versions. Native builds
// use PATCH_EFFECT above and receive the full, editable control set.
#ifndef BLINDS_PREVIEW_MODE
#define BLINDS_PREVIEW_MODE 0
#endif
float3 effect(float2 uv, float time, texture2d<float,access::sample> input, float4 mapping) {
    return blindsEffect(uv,time,input,mapping,float4(BLINDS_PREVIEW_MODE,.65,.55,4),float4(0,1,.2,.04),float4(1,0,0,0),float4(0,1,.9,.6),float4(.75,.12,.03,1),float4(0,30,940,0),float4(3.2,0,0,0));
}
