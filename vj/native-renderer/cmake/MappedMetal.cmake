if(APPLE AND NOT TARGET vj_mapped_metal)
  enable_language(OBJCXX)
  get_filename_component(mapped_src "${CMAKE_CURRENT_LIST_DIR}/../src" ABSOLUTE)
  if(VJ_PATCH_ROOT)
    set(mapped_patch "${VJ_PATCH_ROOT}")
  else()
    get_filename_component(mapped_patch "${mapped_src}/../../../patch" ABSOLUTE)
  endif()
  set(trace_headers "${mapped_patch}/Sources/OutputBridge/include")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${trace_headers}/PatchTraceMath.inc")
  file(READ "${trace_headers}/PatchTraceMath.inc" PATCH_TRACE_MATH)
  configure_file("${mapped_src}/mapped_trace_source.hpp.in" "${CMAKE_CURRENT_BINARY_DIR}/mapped_trace_source.hpp" @ONLY)
  add_library(vj_mapped_metal STATIC "${mapped_src}/mapped_metal.mm")
  set_target_properties(vj_mapped_metal PROPERTIES OBJCXX_STANDARD 20)
  target_compile_options(vj_mapped_metal PRIVATE -fobjc-arc -Wno-deprecated-declarations)
  target_compile_definitions(vj_mapped_metal INTERFACE VJ_MAPPED_METAL=1)
  target_include_directories(vj_mapped_metal INTERFACE "${trace_headers}" "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(vj_mapped_metal PUBLIC "-framework Metal" "-framework IOSurface" "-framework OpenGL" "-framework Foundation")
endif()
